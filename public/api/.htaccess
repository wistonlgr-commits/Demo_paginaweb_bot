# Desactivar reglas de reescritura heredadas (Hotlink protection, WordPress redirects)
<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>

# Permitir CORS universal y desactivar caché para la API
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin"
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
</IfModule>
